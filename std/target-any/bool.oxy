primitive Bool {
	def || (self, other: Bool) Bool {
		return #asm Bool "
			mov rax, qword [rbp + 16]
			or rax, qword [rbp + 24]
			push rax
		"
	}

	def && (self, other: Bool) Bool {
		return #asm Bool "
			mov rax, qword [rbp + 16]
			and rax, qword [rbp + 24]
			push rax
		"
	}

	def == (self, other: Bool) Bool {
		// compare truthiness, as a Bool may hold any non-zero value
		return #asm Bool "
			xor rcx, rcx
			xor rdx, rdx
			cmp qword [rbp + 16], 0
			setne cl
			cmp qword [rbp + 24], 0
			setne dl
			xor rax, rax
			cmp rcx, rdx
			sete al
			push rax
		"
	}

	def != (self, other: Bool) Bool ->
		!(self == other),

	def Str (self) Str {
		if self -> return "true"
		return "false"
	}
}